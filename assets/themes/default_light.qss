/*
   SolderBot — PyDracula Light Theme
   ─────────────────────────────────────
   BG        #F8F8F2   (app background, off-white)
   SURFACE   #6272A4   (inputs, buttons, panels — muted purple)
   SURF2     #495474   (secondary panels, bottom bar)
   BORDER    #6A7CB1   (borders, slightly lighter than surface)
   TEXT      #44475A   (text on light bg)
   TEXT_SURF #F8F8F2   (text on purple surface)
   PURPLE    #BD93F9   (accent highlights)
   PINK      #FF79C6
*/

/* ── Base ── */
QMainWindow, QWidget {
    background-color: #F8F8F2;
    color: #44475A;
    font-family: 'Segoe UI', sans-serif;
    font-size: 13px;
}

/* ── Tooltip ── */
QToolTip {
    color: #44475A;
    background-color: #F8F8F2;
    border: none;
    border-left: 2px solid #FF79C6;
    padding-left: 8px;
    margin: 0px;
}

/* ── Group boxes ── */
QGroupBox {
    background-color: #F8F8F2;
    border: 1px solid #6A7CB1;
    border-radius: 6px;
    margin-top: 22px;
    padding-top: 6px;
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: #6272A4;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    top: 6px;
}

/* ── Buttons ── */
QPushButton {
    background-color: #6272A4;
    border: 1px solid #6A7CB1;
    border-radius: 5px;
    padding: 4px 12px;
    min-height: 28px;
    color: #F8F8F2;
    font-size: 13px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #7082B6;
    border-color: #8090C0;
    color: #F8F8F2;
}

QPushButton:pressed {
    background-color: #546391;
}

QPushButton:disabled {
    background-color: #9FAED8;
    color: #D0D8F0;
    border-color: #8899CC;
}

QPushButton:checked {
    background-color: #BD93F9;
    color: #F8F8F2;
    border-color: #9B6FD9;
}

QPushButton#btn_start {
    background-color: #E8F5EE;
    color: #2D7A4F;
    border: 1px solid #A8D8BC;
    font-weight: 600;
}
QPushButton#btn_start:hover { background-color: #D5EDDE; border-color: #2D7A4F; }

QPushButton#btn_stop {
    background-color: #FBECEC;
    color: #CC3333;
    border: 1px solid #F0BBBB;
    font-weight: 600;
}
QPushButton#btn_stop:hover { background-color: #F5D5D5; border-color: #CC3333; }

/* ── Green / red / accent action buttons ── */
QPushButton#btn_action_green {
    background-color: #E8F5EE;
    color: #2D7A4F;
    border: 1px solid #A8D8BC;
    font-size: 13px;
    font-weight: 600;
}
QPushButton#btn_action_green:hover { background-color: #D5EDDE; border-color: #2D7A4F; }
QPushButton#btn_action_green:disabled { background-color: #F0F8F4; color: #AAAAAA; border-color: #CCCCCC; }

QPushButton#btn_action_red {
    background-color: #FBECEC;
    color: #CC3333;
    border: 1px solid #F0BBBB;
    font-size: 13px;
    font-weight: 600;
}
QPushButton#btn_action_red:hover { background-color: #F5D5D5; border-color: #CC3333; }

QPushButton#btn_action_accent {
    background-color: #BD93F9;
    color: #F8F8F2;
    border: none;
    font-size: 13px;
    font-weight: 600;
}
QPushButton#btn_action_accent:hover { background-color: #C9A8FF; color: #F8F8F2; }
QPushButton#btn_action_accent:disabled { background-color: #9FAED8; color: #D0D8F0; }

/* ── Step / back nav buttons ── */
QPushButton#btn_step {
    background-color: #6272A4;
    color: #F8F8F2;
    border: 1px solid #BD93F9;
    font-size: 12px;
    font-weight: 600;
}
QPushButton#btn_step:hover { background-color: #7082B6; color: #F8F8F2; border-color: #C9A8FF; }
QPushButton#btn_step:disabled { background-color: #9FAED8; color: #D0D8F0; border-color: #8899CC; }

QPushButton#btn_back_nav {
    background-color: transparent;
    color: #6272A4;
    border: 1px solid #6A7CB1;
    font-size: 12px;
    font-weight: 500;
}
QPushButton#btn_back_nav:hover { background-color: #6272A4; color: #F8F8F2; border-color: #6272A4; }

/* ── Camera panel toggle button ── */
QPushButton#btn_cam_toggle {
    background-color: #6272A4;
    color: #F8F8F2;
    border: none;
    border-radius: 3px;
    font-size: 10px;
    font-weight: 700;
    padding: 0;
    min-height: 0;
}
QPushButton#btn_cam_toggle:hover { background-color: #7082B6; color: #F8F8F2; }

/* ── Progress bar ── */
QProgressBar {
    background-color: #6272A4;
    border-radius: 3px;
    border: none;
    min-height: 5px;
    max-height: 5px;
    text-align: center;
}
QProgressBar::chunk {
    background-color: #BD93F9;
    border-radius: 3px;
}

/* ── Log panel ── */
QPlainTextEdit#log_panel {
    background-color: #6272A4;
    border: 1px solid #6A7CB1;
    border-radius: 5px;
    color: #F8F8F2;
    font-family: 'Consolas', 'Cascadia Code', monospace;
    font-size: 12px;
    padding: 4px;
}

/* ── Plain text edit (generic) ── */
QPlainTextEdit {
    background-color: #6272A4;
    border-radius: 5px;
    padding: 10px;
    color: #F8F8F2;
    selection-color: #F8F8F2;
    selection-background-color: #FF79C6;
}
QPlainTextEdit:hover { border: 2px solid #7082B6; }
QPlainTextEdit:focus { border: 2px solid #FF79C6; }

/* ── Line edit ── */
QLineEdit {
    background-color: #6272A4;
    border-radius: 5px;
    border: 2px solid #6272A4;
    padding-left: 10px;
    color: #F8F8F2;
    selection-color: #F8F8F2;
    selection-background-color: #FF79C6;
}
QLineEdit:hover { border: 2px solid #7082B6; }
QLineEdit:focus { border: 2px solid #FF79C6; }

/* ── Combo box ── */
QComboBox {
    background-color: #6272A4;
    border: 2px solid #6272A4;
    border-radius: 5px;
    padding: 3px 8px;
    color: #F8F8F2;
    min-height: 24px;
}
QComboBox:hover { border-color: #7082B6; }
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
    background-color: #6272A4;
    border: 1px solid #6A7CB1;
    color: #FF79C6;
    selection-background-color: #495474;
    selection-color: #F8F8F2;
    outline: none;
    padding: 10px;
}

/* ── Spin boxes ── */
QSpinBox, QDoubleSpinBox {
    background-color: #6272A4;
    border: 2px solid #6272A4;
    border-radius: 5px;
    padding: 3px 6px;
    color: #F8F8F2;
    min-height: 24px;
}
QSpinBox:hover, QDoubleSpinBox:hover { border-color: #7082B6; }
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #495474;
    border: none;
    width: 16px;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #5D6A8C;
}

/* ── Labels ── */
QLabel {
    color: #44475A;
    background-color: transparent;
    font-size: 13px;
}

/* ── Header labels ── */
QLabel#header_title { font-size: 22px; font-weight: 700; }
QLabel#lbl_conn { font-size: 12px; color: #6272A4; }
QLabel#lbl_pos { font-family: 'Consolas', monospace; font-size: 12px; color: #6272A4; }

/* ── Hint / status / divider labels ── */
QLabel#hint_label { color: #6272A4; font-size: 12px; }
QLabel#status_label { color: #9FAED8; font-size: 12px; }
QLabel#divider_label {
    color: #9FAED8;
    font-size: 11px;
    border-top: 1px solid #6A7CB1;
    padding-top: 6px;
}
QLabel#progress_label { color: #6272A4; font-size: 12px; }

/* ── Capture thumbnail ── */
QLabel#capture_thumbnail {
    background-color: #6272A4;
    border-radius: 6px;
    border: 1px solid #6A7CB1;
    font-size: 12px;
    color: #F8F8F2;
}

/* ── Zoom feed overlay ── */
QLabel#zoom_feed {
    background-color: #6272A4;
    border: 1px solid #FF79C6;
    border-radius: 3px;
}

/* ── Graphics view ── */
QGraphicsView#board_view {
    background-color: #F8F8F2;
    border: 1px solid #6A7CB1;
    border-radius: 6px;
}

/* ── Scrollbars ── */
QScrollBar:vertical {
    border: none;
    background: #6272A4;
    width: 8px;
    border-radius: 4px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #BD93F9;
    min-height: 25px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover { background: #C9A8FF; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; background: none; border: none; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

QScrollBar:horizontal {
    border: none;
    background: #6272A4;
    height: 8px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: #BD93F9;
    min-width: 25px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover { background: #C9A8FF; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; background: none; border: none; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }

/* ── Checkbox ── */
QCheckBox::indicator {
    border: 3px solid #6272A4;
    width: 15px;
    height: 15px;
    border-radius: 10px;
    background: #6272A4;
}
QCheckBox::indicator:hover { border: 3px solid #7082B6; }
QCheckBox::indicator:checked {
    background: #BD93F9;
    border: 3px solid #BD93F9;
    background-image: url(:/icons/images/icons/cil-check-alt.png);
}

/* ── Radio button ── */
QRadioButton::indicator {
    border: 3px solid #6272A4;
    width: 15px;
    height: 15px;
    border-radius: 10px;
    background: #6272A4;
}
QRadioButton::indicator:hover { border: 3px solid #7082B6; }
QRadioButton::indicator:checked { background: #BD93F9; border: 3px solid #BD93F9; }

/* ── Sliders ── */
QSlider::groove:horizontal {
    border-radius: 5px;
    height: 10px;
    margin: 0px;
    background-color: #6272A4;
}
QSlider::groove:horizontal:hover { background-color: #6272A4; }
QSlider::handle:horizontal {
    background-color: #BD93F9;
    border: none;
    height: 10px;
    width: 10px;
    margin: 0px;
    border-radius: 5px;
}
QSlider::handle:horizontal:hover { background-color: #C9A8FF; }
QSlider::handle:horizontal:pressed { background-color: #FF79C6; }

QSlider::groove:vertical {
    border-radius: 5px;
    width: 10px;
    margin: 0px;
    background-color: #6272A4;
}
QSlider::handle:vertical {
    background-color: #BD93F9;
    border: none;
    height: 10px;
    width: 10px;
    margin: 0px;
    border-radius: 5px;
}
QSlider::handle:vertical:hover { background-color: #C9A8FF; }
QSlider::handle:vertical:pressed { background-color: #FF79C6; }

/* ── Table widget ── */
QTableWidget {
    background-color: transparent;
    padding: 10px;
    border-radius: 5px;
    gridline-color: #9FAEDA;
    border-bottom: 1px solid #9FAEDA;
}
QTableWidget::item { border-color: #9FAEDA; padding-left: 5px; padding-right: 5px; }
QTableWidget::item:selected { background-color: #BD93F9; color: #F8F8F2; }
QHeaderView::section {
    background-color: #6272A4;
    border: none;
    border-style: none;
    border-bottom: 1px solid #6A7CB1;
    border-right: 1px solid #6A7CB1;
    color: #F8F8F2;
}
QHeaderView::section:horizontal {
    border: 1px solid #6272A4;
    background-color: #6272A4;
    padding: 3px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    color: #F8F8F2;
}
QHeaderView::section:vertical { border: 1px solid #6272A4; }

/* ── Header bar ── */
QFrame#header_bar {
    background-color: #6272A4;
    border-bottom: 1px solid #4E5D8A;
}

QFrame#header_bar QLabel {
    color: #F8F8F2;
}

QFrame#header_bar QPushButton {
    background-color: rgba(255, 255, 255, 0);
    border: none;
    color: #F8F8F2;
}
QFrame#header_bar QPushButton:hover {
    background-color: #BD93F9;
    border-style: solid;
    border-radius: 4px;
}
QFrame#header_bar QPushButton:pressed {
    background-color: #FF79C6;
    border-style: solid;
    border-radius: 4px;
}

/* ── Camera panel ── */
QFrame#camera_panel {
    background-color: #495474;
    border-radius: 8px;
    border: 1px solid #6A7CB1;
}

/* ── Step indicator connector ── */
QFrame#step_connector {
    background-color: #6A7CB1;
    margin-bottom: 16px;
}

/* ── Workflow separator ── */
QFrame#workflow_sep { background-color: #6A7CB1; }

/* ── Tab widget ── */
QTabWidget::pane {
    border: 1px solid #6A7CB1;
    border-radius: 6px;
    background: #F8F8F2;
    top: -1px;
}
QTabWidget::tab-bar { alignment: left; }
QTabBar::tab {
    background: #6272A4;
    color: #D0D8F0;
    border: none;
    border-top: 1px solid #6A7CB1;
    padding: 7px 18px;
    font-size: 12px;
    font-weight: 500;
    min-width: 75px;
}
QTabBar::tab:selected {
    background: #F8F8F2;
    color: #44475A;
    border-top: 2px solid #BD93F9;
}
QTabBar::tab:hover:!selected {
    background: #7082B6;
    color: #F8F8F2;
}

/* ── Command link button ── */
QCommandLinkButton {
    color: #FF79C6;
    border-radius: 5px;
    padding: 5px;
    border: 2px solid #FF79C6;
}
QCommandLinkButton:hover { color: #FFAAFF; background-color: #6272A4; }
QCommandLinkButton:pressed { color: #BD93F9; background-color: #495474; }
