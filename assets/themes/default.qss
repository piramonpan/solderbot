/*
   SolderBot — Dracula Theme
   ─────────────────────────────────────
   BG        #282C34
   SURFACE   #21252B
   SURF2     #2C313A
   BORDER    #3E4451
   TEXT      #DDDDDD
   TEXT_DIM  #717E97
   PURPLE    #BD93F9
   PINK      #FF79C6
*/

/* ── Base ── */
QMainWindow, QWidget {
    background-color: #282C34;
    color: #DDDDDD;
    font-family: 'Segoe UI', sans-serif;
    font-size: 13px;
}

/* ── Tooltip ── */
QToolTip {
    color: #ffffff;
    background-color: rgba(33, 37, 43, 180);
    border: none;
    border-left: 2px solid #FF79C6;
    padding-left: 8px;
    margin: 0px;
}

/* ── Group boxes ── */
QGroupBox {
    background-color: #21252B;
    border: 1px solid #3E4451;
    border-radius: 6px;
    margin-top: 22px;
    padding-top: 6px;
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: #717E97;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    top: 6px;
}

/* ── Buttons ── */
QPushButton {
    background-color: #2C313A;
    border: 1px solid #3E4451;
    border-radius: 5px;
    padding: 4px 12px;
    min-height: 28px;
    color: #DDDDDD;
    font-size: 13px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #3E4451;
    border-color: #555D6E;
    color: #F8F8F2;
}

QPushButton:pressed {
    background-color: #21252B;
}

QPushButton:disabled {
    background-color: #21252B;
    color: #3E4451;
    border-color: #2C313A;
}

QPushButton:checked {
    background-color: #44475A;
    color: #BD93F9;
    border-color: #6272A4;
}

QPushButton#btn_start {
    background-color: #1E3D2C;
    color: #50FA7B;
    border: 1px solid #2A5A3E;
    font-weight: 600;
}
QPushButton#btn_start:hover { background-color: #264D38; border-color: #50FA7B; }

QPushButton#btn_stop {
    background-color: #3D1E1E;
    color: #FF5555;
    border: 1px solid #5A2A2A;
    font-weight: 600;
}
QPushButton#btn_stop:hover { background-color: #4D2626; border-color: #FF5555; }

/* ── Green / red / accent action buttons ── */
QPushButton#btn_action_green {
    background-color: #1E3D2C;
    color: #50FA7B;
    border: 1px solid #2A5A3E;
    font-size: 13px;
    font-weight: 600;
}
QPushButton#btn_action_green:hover { background-color: #264D38; border-color: #50FA7B; }
QPushButton#btn_action_green:disabled { background-color: #1A2E22; color: #3E4451; border-color: #2C313A; }

QPushButton#btn_action_red {
    background-color: #3D1E1E;
    color: #FF5555;
    border: 1px solid #5A2A2A;
    font-size: 13px;
    font-weight: 600;
}
QPushButton#btn_action_red:hover { background-color: #4D2626; border-color: #FF5555; }

QPushButton#btn_iron_on {
    background-color: #1E3D2C; color: #50FA7B; border: 1px solid #2A5A3E;
    font-size: 12px; font-weight: 600; min-height: 0px; padding: 2px 8px;
}
QPushButton#btn_iron_on:hover { background-color: #264D38; border-color: #50FA7B; }

QPushButton#btn_iron_off {
    background-color: #3D1E1E; color: #FF5555; border: 1px solid #5A2A2A;
    font-size: 12px; font-weight: 600; min-height: 0px; padding: 2px 8px;
}
QPushButton#btn_iron_off:hover { background-color: #4D2626; border-color: #FF5555; }

QPushButton#btn_set_temp {
    font-size: 12px; min-height: 0px; padding: 2px 8px;
}

QPushButton#btn_action_accent {
    background-color: #44475A;
    color: #BD93F9;
    border: none;
    font-size: 13px;
    font-weight: 600;
}
QPushButton#btn_action_accent:hover { background-color: #6272A4; color: #F8F8F2; }
QPushButton#btn_action_accent:disabled { background-color: #2C313A; color: #3E4451; }

/* ── Step / back nav buttons ── */
QPushButton#btn_step {
    background-color: #2C313A;
    color: #BD93F9;
    border: 1px solid #6272A4;
    font-size: 12px;
    font-weight: 600;
}
QPushButton#btn_step:hover { background-color: #44475A; color: #F8F8F2; border-color: #BD93F9; }
QPushButton#btn_step:disabled { background-color: #2C313A; color: #3E4451; border-color: #3E4451; }

QPushButton#btn_back_nav {
    background-color: transparent;
    color: #717E97;
    border: 1px solid #3E4451;
    font-size: 12px;
    font-weight: 500;
}
QPushButton#btn_back_nav:hover { background-color: #2C313A; color: #DDDDDD; border-color: #555D6E; }

/* ── Camera panel toggle button ── */
QPushButton#btn_cam_toggle {
    background-color: #2C313A;
    color: #717E97;
    border: none;
    border-radius: 3px;
    font-size: 10px;
    font-weight: 700;
    padding: 0;
    min-height: 0;
}
QPushButton#btn_cam_toggle:hover { background-color: #3E4451; color: #DDDDDD; }

/* ── Progress bar ── */
QProgressBar {
    background-color: #2C313A;
    border-radius: 3px;
    border: none;
    min-height: 5px;
    max-height: 5px;
    text-align: center;
}
QProgressBar::chunk {
    background-color: #BD93F9;
    border-radius: 3px;
}

/* ── Log panel ── */
QPlainTextEdit#log_panel {
    background-color: #1E2127;
    border: 1px solid #2C313A;
    border-radius: 5px;
    color: #717E97;
    font-family: 'Consolas', 'Cascadia Code', monospace;
    font-size: 12px;
    padding: 4px;
}

/* ── Plain text edit (generic) ── */
QPlainTextEdit {
    background-color: #1B1D23;
    border-radius: 5px;
    padding: 10px;
    selection-color: #ffffff;
    selection-background-color: #FF79C6;
}
QPlainTextEdit:hover { border: 2px solid #404859; }
QPlainTextEdit:focus { border: 2px solid #5B657C; }

/* ── Line edit ── */
QLineEdit {
    background-color: #21252B;
    border-radius: 5px;
    border: 2px solid #21252B;
    padding-left: 10px;
    selection-color: #ffffff;
    selection-background-color: #FF79C6;
}
QLineEdit:hover { border: 2px solid #404859; }
QLineEdit:focus { border: 2px solid #5B657C; }

/* ── Combo box ── */
QComboBox {
    background-color: #2C313A;
    border: 1px solid #3E4451;
    border-radius: 5px;
    padding: 3px 8px;
    color: #DDDDDD;
    min-height: 24px;
}
QComboBox:hover { border-color: #555D6E; }
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
    background-color: #2C313A;
    border: 1px solid #3E4451;
    color: #FF79C6;
    selection-background-color: #44475A;
    selection-color: #F8F8F2;
    outline: none;
    padding: 10px;
}

/* ── Spin boxes ── */
QSpinBox, QDoubleSpinBox {
    background-color: #2C313A;
    border: 1px solid #3E4451;
    border-radius: 5px;
    padding: 3px 6px;
    color: #DDDDDD;
    min-height: 24px;
}
QSpinBox:hover, QDoubleSpinBox:hover { border-color: #555D6E; }
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #3E4451;
    border: none;
    width: 16px;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #555D6E;
}

/* ── Labels ── */
QLabel {
    color: #DDDDDD;
    background-color: transparent;
    font-size: 13px;
}

/* ── Header labels ── */
QLabel#header_title { font-size: 24px; font-weight: 700; }
QLabel#welcome_title { font-size: 46px; font-weight: 700; }
QLabel#welcome_sub { font-size: 30px; font-weight: 700; }
QLabel#live_temp_big { font-size: 36px; font-weight: 700; color: #dd9547; }
QLabel#lbl_conn { font-size: 20px; color: #717E97; }
QLabel#lbl_pos { font-family: 'Consolas', monospace; font-size: 20px; color: #717E97; }

/* ── Hint / status / divider labels ── */
QLabel#hint_label { color: #717E97; font-size: 12px; }
QLabel#status_label { color: #3E4451; font-size: 12px; }
QLabel#divider_label {
    color: #3E4451;
    font-size: 11px;
    border-top: 1px solid #3E4451;
    padding-top: 6px;
}
QLabel#progress_label { color: #717E97; font-size: 12px; }

/* ── Capture thumbnail ── */
QLabel#capture_thumbnail {
    background-color: #2C313A;
    border-radius: 6px;
    border: 1px solid #3E4451;
    font-size: 12px;
    color: #717E97;
}

/* ── Zoom feed overlay ── */
QLabel#zoom_feed {
    background-color: #2C313A;
    border: 1px solid #FF79C6;
    border-radius: 3px;
}

/* ── Graphics view ── */
QGraphicsView#board_view {
    background-color: #1E2127;
    border: 1px solid #2C313A;
    border-radius: 6px;
}

/* ── Scrollbars ── */
QScrollBar:vertical {
    border: none;
    background: #282C34;
    width: 8px;
    border-radius: 4px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #BD93F9;
    min-height: 25px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover { background: #C9A8FF; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; background: none; border: none; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

QScrollBar:horizontal {
    border: none;
    background: #282C34;
    height: 8px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: #BD93F9;
    min-width: 25px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover { background: #C9A8FF; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; background: none; border: none; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }

/* ── Checkbox ── */
QCheckBox::indicator {
    border: 3px solid #343B48;
    width: 15px;
    height: 15px;
    border-radius: 10px;
    background: #2C313C;
}
QCheckBox::indicator:hover { border: 3px solid #3A4252; }
QCheckBox::indicator:checked {
    background: #343B48;
    border: 3px solid #343B48;
    background-image: url(:/icons/images/icons/cil-check-alt.png);
}

/* ── Radio button ── */
QRadioButton::indicator {
    border: 3px solid #343B48;
    width: 15px;
    height: 15px;
    border-radius: 10px;
    background: #2C313C;
}
QRadioButton::indicator:hover { border: 3px solid #3A4252; }
QRadioButton::indicator:checked { background: #5E6A82; border: 3px solid #343B48; }

/* ── Sliders ── */
QSlider::groove:horizontal {
    border-radius: 5px;
    height: 10px;
    margin: 0px;
    background-color: #343B48;
}
QSlider::groove:horizontal:hover { background-color: #373F4C; }
QSlider::handle:horizontal {
    background-color: #BD93F9;
    border: none;
    height: 10px;
    width: 10px;
    margin: 0px;
    border-radius: 5px;
}
QSlider::handle:horizontal:hover { background-color: #C9A8FF; }
QSlider::handle:horizontal:pressed { background-color: #FF79C6; }

QSlider::groove:vertical {
    border-radius: 5px;
    width: 10px;
    margin: 0px;
    background-color: #343B48;
}
QSlider::handle:vertical {
    background-color: #BD93F9;
    border: none;
    height: 10px;
    width: 10px;
    margin: 0px;
    border-radius: 5px;
}
QSlider::handle:vertical:hover { background-color: #C9A8FF; }
QSlider::handle:vertical:pressed { background-color: #FF79C6; }

/* ── Table widget ── */
QTableWidget {
    background-color: transparent;
    padding: 10px;
    border-radius: 5px;
    gridline-color: #3E4451;
    border-bottom: 1px solid #3E4451;
}
QTableWidget::item { border-color: #3E4451; padding-left: 5px; padding-right: 5px; }
QTableWidget::item:selected { background-color: #BD93F9; }
QHeaderView::section {
    background-color: #21252B;
    border: 1px solid #3E4451;
    border-style: none;
    border-bottom: 1px solid #3E4451;
    border-right: 1px solid #3E4451;
}
QHeaderView::section:horizontal {
    border: 1px solid #21252B;
    background-color: #21252B;
    padding: 3px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
}
QHeaderView::section:vertical { border: 1px solid #3E4451; }

/* ── Header bar ── */
QFrame#header_bar {
    background-color: #1E2127;
    border-bottom: 1px solid #2C313A;
}

/* ── Camera panel ── */
QFrame#camera_panel {
    background-color: #111318;
    border-radius: 8px;
    border: 1px solid #2C313A;
}

/* ── Step indicator connector ── */
QFrame#step_connector {
    background-color: #3E4451;
    margin-bottom: 16px;
}

/* ── Workflow separator ── */
QFrame#workflow_sep { background-color: #3E4451; }

/* ── Tab widget ── */
QTabWidget::pane {
    border: 1px solid #2C313A;
    border-radius: 6px;
    background: #282C34;
    top: -1px;
}
QTabWidget::tab-bar { alignment: left; }
QTabBar::tab {
    background: #1E2127;
    color: #44475A;
    border: none;
    border-top: 1px solid #2C313A;
    padding: 7px 18px;
    font-size: 12px;
    font-weight: 500;
    min-width: 75px;
}
QTabBar::tab:selected {
    background: #282C34;
    color: #F8F8F2;
    border-top: 2px solid #BD93F9;
}
QTabBar::tab:hover:!selected {
    background: #282C34;
    color: #AAAAC0;
}

/* ── Command link button ── */
QCommandLinkButton {
    color: #FF79C6;
    border-radius: 5px;
    padding: 5px;
}
QCommandLinkButton:hover { color: #FFAAFF; background-color: #2C313C; }
QCommandLinkButton:pressed { color: #BD93F9; background-color: #343A4A; }
