/*
   SolderBot — Modern Grey Theme
   ─────────────────────────────────────
   DARK      #595959
   MID_DARK  #7F7F7F
   MID       #A5A5A5
   LIGHT     #CCCCCC
   LIGHTEST  #F2F2F2
*/

/* ── Base ── */
QMainWindow, QWidget {
    background-color: #F2F2F2;
    color: #595959;
    font-family: 'Segoe UI', sans-serif;
    font-size: 14px;
}

/* ── Tooltip ── */
QToolTip {
    color: #F2F2F2;
    background-color: #595959;
    border: none;
    border-left: 2px solid #A5A5A5;
    padding-left: 8px;
    margin: 0px;
}

/* ── Group boxes ── */
QGroupBox {
    background-color: #F2F2F2;
    border: 1px solid #CCCCCC;
    border-radius: 8px;
    margin-top: 22px;
    padding-top: 6px;
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #A5A5A5;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    top: 6px;
}

/* ── Buttons ── */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #CCCCCC;
    border-radius: 10px;
    padding: 5px 16px;
    min-height: 32px;
    color: #595959;
    font-size: 14px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #F2F2F2;
    border-color: #A5A5A5;
    color: #3A3A3A;
}

QPushButton:pressed {
    background-color: #E8E8E8;
    border-color: #7F7F7F;
}

QPushButton:disabled {
    background-color: #F2F2F2;
    color: #CCCCCC;
    border-color: #E0E0E0;
}

QPushButton:checked {
    background-color: #595959;
    color: #F2F2F2;
    border-color: #595959;
}

QPushButton#btn_start {
    background-color: #EEF7F2;
    color: #2D7A4F;
    border: 1px solid #B8DEC9;
    font-weight: 600;
}
QPushButton#btn_start:hover { background-color: #DFF0E8; border-color: #2D7A4F; }

QPushButton#btn_stop {
    background-color: #FDF0F0;
    color: #CC3333;
    border: 1px solid #F0C0C0;
    font-weight: 600;
}
QPushButton#btn_stop:hover { background-color: #F8DEDE; border-color: #CC3333; }

/* ── Green / red / accent action buttons ── */
QPushButton#btn_action_green {
    background-color: #EEF7F2;
    color: #2D7A4F;
    border: 1px solid #B8DEC9;
    font-size: 14px;
    font-weight: 600;
}
QPushButton#btn_action_green:hover { background-color: #DFF0E8; border-color: #2D7A4F; }
QPushButton#btn_action_green:disabled { background-color: #F5FAF7; color: #BBBBBB; border-color: #E0E0E0; }

QPushButton#btn_action_red {
    background-color: #FDF0F0;
    color: #CC3333;
    border: 1px solid #F0C0C0;
    font-size: 14px;
    font-weight: 600;
}
QPushButton#btn_action_red:hover { background-color: #F8DEDE; border-color: #CC3333; }

QPushButton#btn_iron_on {
    background-color: #EEF7F2; color: #2D7A4F; border: 1px solid #B8DEC9;
    font-size: 15px; font-weight: 600; min-height: 0px; padding: 2px 8px;
}
QPushButton#btn_iron_on:hover { background-color: #DFF0E8; border-color: #2D7A4F; }

QPushButton#btn_iron_off {
    background-color: #FDF0F0; color: #CC3333; border: 1px solid #F0C0C0;
    font-size: 15px; font-weight: 600; min-height: 0px; padding: 2px 8px;
}
QPushButton#btn_iron_off:hover { background-color: #F8DEDE; border-color: #CC3333; }

QPushButton#btn_set_temp { font-size: 12px; min-height: 0px; padding: 2px 8px; }

QPushButton#btn_action_accent {
    background-color: #595959;
    color: #F2F2F2;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
}
QPushButton#btn_action_accent:hover { background-color: #3A3A3A; }
QPushButton#btn_action_accent:disabled { background-color: #CCCCCC; color: #F2F2F2; }

/* ── Step / back nav buttons ── */
QPushButton#btn_step {
    background-color: #595959;
    color: #F2F2F2;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
}
QPushButton#btn_step:hover { background-color: #3A3A3A; }
QPushButton#btn_step:disabled { background-color: #CCCCCC; color: #F2F2F2; }

QPushButton#btn_back_nav {
    background-color: transparent;
    color: #A5A5A5;
    border: 1px solid #CCCCCC;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 500;
}
QPushButton#btn_back_nav:hover { background-color: #F2F2F2; color: #595959; border-color: #A5A5A5; }

/* ── Step size selector buttons ── */
QPushButton#btn_step_size {
    padding: 2px 4px;
    min-height: 22px;
    font-size: 12px;
}

/* ── Camera panel toggle button ── */
QPushButton#btn_cam_toggle {
    background-color: #E0E0E0;
    color: #7F7F7F;
    border: none;
    border-radius: 3px;
    font-size: 10px;
    font-weight: 700;
    padding: 0;
    min-height: 0;
}
QPushButton#btn_cam_toggle:hover { background-color: #CCCCCC; color: #595959; }

/* ── Progress bar ── */
QProgressBar {
    background-color: #E0E0E0;
    border-radius: 3px;
    border: none;
    min-height: 5px;
    max-height: 5px;
}
QProgressBar::chunk {
    background-color: #7F7F7F;
    border-radius: 3px;
}

/* ── Log panel ── */
QPlainTextEdit#log_panel {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    color: #595959;
    font-family: 'Consolas', 'Cascadia Code', monospace;
    font-size: 12px;
    padding: 4px;
}

/* ── Plain text edit (generic) ── */
QPlainTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    padding: 10px;
    color: #595959;
    selection-color: #F2F2F2;
    selection-background-color: #595959;
}
QPlainTextEdit:hover { border: 1px solid #A5A5A5; }
QPlainTextEdit:focus { border: 1px solid #595959; }

/* ── Line edit ── */
QLineEdit {
    background-color: #FFFFFF;
    border-radius: 6px;
    border: 1px solid #E0E0E0;
    padding-left: 10px;
    color: #595959;
    selection-color: #F2F2F2;
    selection-background-color: #595959;
}
QLineEdit:hover { border: 1px solid #A5A5A5; }
QLineEdit:focus { border: 1px solid #595959; }

/* ── Combo box ── */
QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    padding: 3px 8px;
    color: #595959;
    min-height: 24px;
}
QComboBox:hover { border-color: #A5A5A5; }
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    color: #595959;
    selection-background-color: #F2F2F2;
    selection-color: #3A3A3A;
    outline: none;
    padding: 6px;
}

/* ── Spin boxes ── */
QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    padding: 3px 6px;
    color: #595959;
    min-height: 24px;
}
QSpinBox:hover, QDoubleSpinBox:hover { border-color: #A5A5A5; }
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #F2F2F2;
    border: none;
    width: 16px;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #E0E0E0;
}

/* ── Labels ── */
QLabel {
    color: #595959;
    background-color: transparent;
    font-size: 13px;
}

/* ── Header labels ── */
QLabel#header_title { font-size: 24px; font-weight: 700; color: #3A3A3A; }
QLabel#welcome_title { font-size: 46px; font-weight: 700; color: #3A3A3A; }
QLabel#live_temp_big { font-size: 36px; font-weight: 700; color: #C07020; }
QLabel#welcome_sub   { font-size: 15px; font-weight: 400; color: #A5A5A5; }
QLabel#checklist_dot { font-size: 16px; color: #595959; background: transparent; }
QLabel#lbl_conn { font-size: 13px; color: #7F7F7F; }
QLabel#lbl_pos { font-family: 'Consolas', monospace; font-size: 13px; color: #7F7F7F; }

/* ── Hint / status / divider labels ── */
QLabel#hint_label { color: #7F7F7F; font-size: 13px; }
QLabel#status_label { color: #A5A5A5; font-size: 13px; }
QLabel#divider_label {
    color: #A5A5A5;
    font-size: 11px;
    border-top: 1px solid #E0E0E0;
    padding-top: 6px;
}
QLabel#progress_label { color: #7F7F7F; font-size: 12px; }

/* ── Capture thumbnail ── */
QLabel#capture_thumbnail {
    background-color: #F2F2F2;
    border-radius: 6px;
    border: 1px solid #E0E0E0;
    font-size: 12px;
    color: #A5A5A5;
}

/* ── Zoom feed overlay ── */
QLabel#zoom_feed {
    background-color: #CCCCCC;
    border: 1px solid #7F7F7F;
    border-radius: 3px;
}

/* ── Graphics view ── */
QGraphicsView#board_view {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
}

/* ── Scrollbars ── */
QScrollBar:vertical {
    border: none;
    background: #F2F2F2;
    width: 8px;
    border-radius: 4px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #CCCCCC;
    min-height: 25px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover { background: #A5A5A5; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; background: none; border: none; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

QScrollBar:horizontal {
    border: none;
    background: #F2F2F2;
    height: 8px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: #CCCCCC;
    min-width: 25px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover { background: #A5A5A5; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; background: none; border: none; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }

/* ── Checkbox ── */
QCheckBox::indicator {
    border: 2px solid #CCCCCC;
    width: 15px;
    height: 15px;
    border-radius: 4px;
    background: #FFFFFF;
}
QCheckBox::indicator:hover { border: 2px solid #7F7F7F; }
QCheckBox::indicator:checked {
    background: #595959;
    border: 2px solid #595959;
    background-image: url(:/icons/images/icons/cil-check-alt.png);
}

/* ── Radio button ── */
QRadioButton::indicator {
    border: 2px solid #CCCCCC;
    width: 15px;
    height: 15px;
    border-radius: 8px;
    background: #FFFFFF;
}
QRadioButton::indicator:hover { border: 2px solid #7F7F7F; }
QRadioButton::indicator:checked { background: #595959; border: 2px solid #595959; }

/* ── Sliders ── */
QSlider::groove:horizontal {
    border-radius: 3px;
    height: 6px;
    margin: 0px;
    background-color: #E0E0E0;
}
QSlider::handle:horizontal {
    background-color: #7F7F7F;
    border: none;
    height: 14px;
    width: 14px;
    margin: -4px 0;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover { background-color: #595959; }
QSlider::handle:horizontal:pressed { background-color: #3A3A3A; }

QSlider::groove:vertical {
    border-radius: 3px;
    width: 6px;
    margin: 0px;
    background-color: #E0E0E0;
}
QSlider::handle:vertical {
    background-color: #7F7F7F;
    border: none;
    height: 14px;
    width: 14px;
    margin: 0 -4px;
    border-radius: 7px;
}
QSlider::handle:vertical:hover { background-color: #595959; }
QSlider::handle:vertical:pressed { background-color: #3A3A3A; }

/* ── Table widget ── */
QTableWidget {
    background-color: #FFFFFF;
    padding: 10px;
    border-radius: 8px;
    gridline-color: #E0E0E0;
    border: 1px solid #E0E0E0;
}
QTableWidget::item { border-color: #E0E0E0; padding-left: 5px; padding-right: 5px; }
QTableWidget::item:selected { background-color: #E8E8E8; color: #3A3A3A; }
QHeaderView::section {
    background-color: #F2F2F2;
    border: none;
    border-bottom: 1px solid #E0E0E0;
    border-right: 1px solid #E0E0E0;
    color: #7F7F7F;
    font-weight: 600;
    font-size: 11px;
}
QHeaderView::section:horizontal {
    background-color: #F2F2F2;
    padding: 5px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    color: #7F7F7F;
}
QHeaderView::section:vertical { border: 1px solid #E0E0E0; }

/* ── Header bar ── */
QFrame#header_bar {
    background-color: #E8E8E8;
    border-bottom: 1px solid #D4D4D4;
}

QFrame#header_bar QLabel {
    color: #3A3A3A;
}

QFrame#header_bar QPushButton {
    background-color: transparent;
    border: none;
    color: #595959;
}
QFrame#header_bar QPushButton:hover {
    background-color: #D4D4D4;
    border-radius: 8px;
}
QFrame#header_bar QPushButton:pressed {
    background-color: #CCCCCC;
    border-radius: 8px;
}

QFrame#header_bar QPushButton#btn_stop {
    background-color: #CCCCCC;
    color: #595959;
    border: 1px solid #B0B0B0;
    border-radius: 4px;
    font-weight: 700;
}
QFrame#header_bar QPushButton#btn_stop:hover {
    background-color: #B0B0B0;
    border-color: #7F7F7F;
    color: #3A3A3A;
}

/* ── Camera panel ── */
QFrame#camera_panel {
    background-color: #2A2A2A;
    border-radius: 8px;
    border: 1px solid #E0E0E0;
}

/* ── Step indicator connector ── */
QFrame#step_connector {
    background-color: #E0E0E0;
    margin-bottom: 16px;
}

/* ── Workflow separator ── */
QFrame#workflow_sep { background-color: #E0E0E0; }

/* ── Tab widget ── */
QTabWidget::pane {
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    background: #F2F2F2;
    top: -1px;
}
QTabWidget::tab-bar { alignment: left; }
QTabBar::tab {
    background: transparent;
    color: #A5A5A5;
    border: none;
    border-top: 2px solid transparent;
    border-bottom: none;
    padding: 8px 20px;
    font-size: 12px;
    font-weight: 500;
    min-width: 75px;
}
QTabBar::tab:selected {
    background: transparent;
    color: #595959;
    border-top: 2px solid #595959;
    font-weight: 600;
}
QTabBar::tab:hover:!selected {
    color: #7F7F7F;
    border-top: 2px solid #CCCCCC;
}

/* ── Command link button ── */
QCommandLinkButton {
    color: #595959;
    border-radius: 6px;
    padding: 5px;
    border: 1px solid #CCCCCC;
}
QCommandLinkButton:hover { background-color: #F2F2F2; border-color: #A5A5A5; }
QCommandLinkButton:pressed { background-color: #E0E0E0; }
